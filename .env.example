# Database — Docker Postgres (required for local/dev)
# Start with: docker compose up -d db
DATABASE_URL=postgresql+psycopg://odc:odc@localhost:5432/meeting_room

# Timezone & reminders
ODC_TIMEZONE=America/Sao_Paulo
REMINDER_LEAD_MINUTES=15

# OpenAI
OPENAI_API_KEY=

# Azure OpenAI (optional alternative to OPENAI_API_KEY)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Brevo transactional email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ODC Meeting Room
BREVO_TEMPLATE_BOOKING_CONFIRMED=
BREVO_TEMPLATE_BOOKING_EXTENDED=
BREVO_TEMPLATE_BOOKING_CANCELLED=
BREVO_TEMPLATE_VACATE_REMINDER=
BREVO_TEMPLATE_WAITLIST_AVAILABLE=

# Microsoft Teams (optional; separate from Brevo)
TEAMS_WEBHOOK_URL=
TEAMS_GRAPH_TENANT_ID=
TEAMS_GRAPH_CLIENT_ID=
TEAMS_GRAPH_CLIENT_SECRET=
