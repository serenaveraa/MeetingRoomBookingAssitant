# Database — prefer AWS RDS when deployed (see infra/local.env after CloudFormation,
# or Secrets Manager odc-mrba/DATABASE_URL from the shell provision scripts).
# Optional offline/local: docker compose up -d db and use the localhost URL below.
DATABASE_URL=postgresql+psycopg://odc:odc@localhost:5432/meeting_room
# Example RDS (ssl required):
# DATABASE_URL=postgresql+psycopg://odcadmin:PASSWORD@HOST:5432/meeting_room?sslmode=require

# Cloud (AWS RDS) — fetch from Secrets Manager or infra/local.env at deploy time;
# do not commit real values. Shape:
# postgresql+psycopg://USER:PASSWORD@HOST:5432/meeting_room?sslmode=require
# See infra/README.md

# Timezone & reminders
ODC_TIMEZONE=America/Montevideo
REMINDER_LEAD_MINUTES=15

# Set true on AWS Lambda (API + reminder). Skips APScheduler; uses NullPool DB connections.
RUNNING_IN_LAMBDA=false

# Frontend → backend
API_BASE_URL=http://127.0.0.1:8000

# LLM — prefer Groq (free tier) for local smoke tests
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (optional alternative)
OPENAI_API_KEY=

# Azure OpenAI (optional alternative)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Brevo transactional email (hosted templates)
# Template IDs are required — without them bookings succeed but email fails.
# Create/reuse templates: python infra/scripts/create_brevo_templates.py
BREVO_API_KEY=                       # API key from Brevo
BREVO_SENDER_EMAIL=                  # verified sender email registered in Brevo
BREVO_SENDER_NAME=ODC Meeting Room   # display name for the sender address
BREVO_TEMPLATE_BOOKING_CONFIRMED=    # Brevo template ID for booking confirmation
BREVO_TEMPLATE_BOOKING_EXTENDED=     # Brevo template ID for booking extension
BREVO_TEMPLATE_BOOKING_CANCELLED=    # Brevo template ID for booking cancellation
BREVO_TEMPLATE_VACATE_REMINDER=      # Brevo template ID for vacate reminder
BREVO_TEMPLATE_WAITLIST_AVAILABLE=   # Brevo template ID for waitlist slot available

# Microsoft Teams (optional; separate from Brevo)
TEAMS_WEBHOOK_URL=
TEAMS_GRAPH_TENANT_ID=
TEAMS_GRAPH_CLIENT_ID=
TEAMS_GRAPH_CLIENT_SECRET=
