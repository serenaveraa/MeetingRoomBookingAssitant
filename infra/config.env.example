# Copy to infra/config.env (gitignored) and adjust before running scripts.
# AWS region (sa-east-1) is near ODC; app timezone is America/Montevideo
# (Uruguay). Change AWS_REGION if your account uses a different region.

AWS_REGION=sa-east-1
PROJECT_PREFIX=odc-mrba

# RDS identifiers (stable across re-runs)
DB_INSTANCE_IDENTIFIER=odc-mrba-postgres
DB_NAME=meeting_room
DB_MASTER_USERNAME=odc_admin
SECRET_NAME=odc-mrba/DATABASE_URL
RDS_SECURITY_GROUP_NAME=odc-mrba-rds-sg
DB_SUBNET_GROUP_NAME=odc-mrba-db-subnets

# Required for manual psql/migration access (your public IP /32).
# Leave unset to auto-detect via checkip.amazonaws.com during provision.
# ADMIN_CIDR=203.0.113.10/32

# Optional: Lambda security group for SG-to-SG ingress on port 5432.
# Set when the vacate-reminder Lambda (or VPC-attached agent path) is provisioned.
# LAMBDA_SECURITY_GROUP_ID=sg-0123456789abcdef0

# Optional: non-default VPC (defaults to account default VPC)
# VPC_ID=vpc-0123456789abcdef0
